{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/docs/**",
              "components/icons/**",
              "ui_kits/connect-foundations/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|IBM Plex Mono|IBM Plex Sans|Inter))/i]",
        "message": "Font not provided by the design system. Available: Poppins, IBM Plex Mono, IBM Plex Sans, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: eyebrow, title, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|hierarchy|icon|state|children|iconNode|disabled|onClick|type|style|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: size, hierarchy, icon, state, children, iconNode, disabled, onClick, type, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='hierarchy'] > Literal[value!=/^(?:primary|secondary color|secondary gray|tertiary color|tertiary gray|link color|link gray)$/]",
        "message": "<Button> hierarchy must be one of 'primary' | 'secondary color' | 'secondary gray' | 'tertiary color' | 'tertiary gray' | 'link color' | 'link gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:false|leading|trailing|dot|only)$/]",
        "message": "<Button> icon must be one of 'false' | 'leading' | 'trailing' | 'dot' | 'only'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|focused|disabled)$/]",
        "message": "<Button> state must be one of 'default' | 'hover' | 'focused' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonBase'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|icon|children|iconNode|style|className|key|ref|className|style|children)$/]",
        "message": "<ButtonBase> doesn't accept that prop. Declared props: size, icon, children, iconNode, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonBase'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<ButtonBase> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonBase'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:false|leading|trailing|dot|only)$/]",
        "message": "<ButtonBase> icon must be one of 'false' | 'leading' | 'trailing' | 'dot' | 'only'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Circle'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|className|key|ref|className|style|children)$/]",
        "message": "<Circle> doesn't accept that prop. Declared props: size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|height|hint|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: label, width, height, hint, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContainerSpacer'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|className|key|ref|className|style|children)$/]",
        "message": "<ContainerSpacer> doesn't accept that prop. Declared props: size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContainerSpacer'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm - 640px|md - 768px|lg - 1024px|xl - 1280px)$/]",
        "message": "<ContainerSpacer> size must be one of 'sm - 640px' | 'md - 768px' | 'lg - 1024px' | 'xl - 1280px'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DesignNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|heading|supportingText|children|style|className|key|ref|className|style|children)$/]",
        "message": "<DesignNote> doesn't accept that prop. Declared props: size, heading, supportingText, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DesignNote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<DesignNote> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|className|key|ref|className|style|children)$/]",
        "message": "<Dot> doesn't accept that prop. Declared props: size, color, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Dot> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Isotype'] > JSXAttribute > JSXIdentifier[name!=/^(?:darkMode|variant|size|style|className|key|ref|className|style|children)$/]",
        "message": "<Isotype> doesn't accept that prop. Declared props: darkMode, variant, size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Isotype'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:false|true|negative|positive)$/]",
        "message": "<Isotype> variant must be one of 'false' | 'true' | 'negative' | 'positive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:darkMode|lockup|size|style|className|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: darkMode, lockup, size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:connect|divemotor|ai|wordmark)$/]",
        "message": "<Logo> lockup must be one of 'connect' | 'divemotor' | 'ai' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeasureLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:numberPosition|length|label|style|className|key|ref|className|style|children)$/]",
        "message": "<MeasureLine> doesn't accept that prop. Declared props: numberPosition, length, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeasureLine'] > JSXAttribute[name.name='numberPosition'] > Literal[value!=/^(?:left|right|top|bottom)$/]",
        "message": "<MeasureLine> numberPosition must be one of 'left' | 'right' | 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeasureLineBase'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|length|vertical|style|className|key|ref|className|style|children)$/]",
        "message": "<MeasureLineBase> doesn't accept that prop. Declared props: type, length, vertical, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeasureLineBase'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:solid|spacer)$/]",
        "message": "<MeasureLineBase> type must be one of 'solid' | 'spacer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShadowCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|children|style|className|key|ref|className|style|children)$/]",
        "message": "<ShadowCard> doesn't accept that prop. Declared props: level, label, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShadowCard'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<ShadowCard> level must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spacer'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|direction|showLabel|style|className|key|ref|className|style|children)$/]",
        "message": "<Spacer> doesn't accept that prop. Declared props: size, direction, showLabel, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spacer'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:01|02|03|04|05|06|08|10|12|16|20|24|32|40|48|56|64)$/]",
        "message": "<Spacer> size must be one of '01' | '02' | '03' | '04' | '05' | '06' | '08' | '10' | '12' | '16' | '20' | '24' | '32' | '40' | '48' | '56' | '64'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spacer'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:x-axis|y-axis)$/]",
        "message": "<Spacer> direction must be one of 'x-axis' | 'y-axis'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpacingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|rem|px|style|className|key|ref|className|style|children)$/]",
        "message": "<SpacingRow> doesn't accept that prop. Declared props: step, rem, px, style, className."
      }
    ]
  },
