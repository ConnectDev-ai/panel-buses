# Copiar a .env y completar. Nunca commitear el .env real.

# Neon (Postgres). Mismo valor que DATABASE_URL en el .env de QS: ambos repos
# escriben a la MISMA base. Pedir el connection string al dueño del proyecto QS.
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# S3 de donde este repo LEE (nunca escribe) los dos CSV que sube dataQS.py
# (repo QS). Credenciales de solo lectura si es posible — no hace falta permiso
# de escritura para nada de este repo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=exportacion-datos-connect
S3_PREFIX=quicksight/conectividad

# Solo para rutas/export_bus_viajes_neon.py (manual, no corre en el cron diario).
# Ruta al mart de rendimientos.kf si no se corre parado dentro de ese repo.
# TRIPS_FEATURES_GLOB=C:/.../flespi-routes/data/marts/trips_features/year=*/month=*/trips.parquet
